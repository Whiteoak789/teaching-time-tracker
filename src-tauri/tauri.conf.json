{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Teaching Time Tracker",
  "version": "1.0.3",
  "identifier": "com.grim789.teaching-time-tracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Teaching Time Tracker",
      "width": 1440,
      "height": 940,
      "minWidth": 900,
      "minHeight": 650,
      "resizable": true,
      "fullscreen": false,
      "center": true
    }],
    "security": { "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Track clinical teaching time privately and offline",
    "longDescription": "A local-first calendar, timesheet, notes, reporting, and backup app for teacher candidates.",
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
